#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUNA 1 // numbers + nav
#define SYM  2
#define MISC 3
#define MOU  4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUNA SYM>;
            then-layer = <MISC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T        &kp Y &kp U &kp I     &kp O   &kp P    &kp LBKT
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G        &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B        &kp N &kp M &kp COMMA &kp DOT &kp LGUI &kp ESC
                            &kp LALT &mo NUNA &kp SPACE        &kp BSPC &mo SYM &kp RET
            >;
        };

        nuna {
            display-name = "NUNA";
            bindings = <
                &trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5          &kp INS &kp HOME &kp UP   &kp END   &kp PG_UP &trans
                &trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0          &kp DEL &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &none
                &trans &none  &none  &none  &none  &kp LGUI        &none   &none    &none    &none     &none     &trans
                                     &trans &trans &trans          &trans &trans &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans &kp LS(EQUAL) &kp LS(N8)    &kp LS(N9)   &kp BSLH   &kp LS(N0)        &kp EQUAL  &kp LS(FSLH) &kp RA(N8) &kp RA(N9) &kp RA(EQUAL) &trans
                &trans &kp RA(RBKT)  &kp NUBS      &kp LS(NUBS) &kp LS(N2) &kp MINUS         &kp LS(N7) &kp FSLH     &kp RA(N7) &kp RA(N0) &kp LS(RBKT)  &none
                &trans &kp LS(NUHS)  &kp LS(MINUS) &kp LS(N1)   &kp RA(N2) &kp RA(N4)        &kp GRAVE  &kp LS(N3)   &kp LS(N5) &kp LS(N6) &none         &trans
                                                                 &trans &trans &trans        &trans &trans &trans
            >;
        };

        misc {
            display-name = "MISC";
            bindings = <
                &trans &kp F1  &kp F2  &kp F3 &kp F4 &kp F5                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                &trans &kp F6  &kp F7  &kp F8 &kp F9 &kp F10               &none        &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &none        &bt BT_CLR
                &trans &kp F11 &kp F12 &none  &none  &studio_unlock        &kp PSCRN    &kp C_PREV   &kp C_PP     &kp C_NEXT   &none        &trans
                                               &trans &trans &trans        &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp LCLK &mkp MCLK &mkp RCLK           &mkp LCLK &mkp MCLK &mkp RCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
